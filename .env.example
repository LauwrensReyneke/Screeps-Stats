# Screeps API credentials
# Get your token from https://screeps.com/a/#!/account
SCREEPS_TOKEN=your_screeps_token_here

# Base URL for the Screeps API
# For screeps.com: https://screeps.com
# For private server: http://your-server:21025
SCREEPS_API_BASE_URL=https://screeps.com

# Optional: shard name (e.g. shard0, shard1, shard2, shard3)
# Leave empty to use the default (shard0)
SCREEPS_SHARD=shard0

# Vercel Blob token — required for SQLite history persistence
# Create a Blob store in your Vercel project and copy the read/write token.
# https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxx

